// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  incomes            Income[]
  incomeReceipts     IncomeReceipt[]
  fixedExpenses      FixedExpense[]
  transactions       Transaction[]
  creditCards        CreditCard[]
  cardPurchases      CardPurchase[]
  jars               Jar[]
  jarDeposits        JarDeposit[]
  periodAllocations  PeriodAllocation[]
  categories         Category[]
  expensePayments    ExpensePayment[]
  cardBillEstimates  CardBillEstimate[]
  balanceAdjustments BalanceAdjustment[]
  fixedExpensePauses FixedExpensePause[]
  expenseDeferrals   ExpenseDeferral[]
  people             Person[]
  loans              Loan[]
  loanRepayments     LoanRepayment[]
  pushSubscriptions  PushSubscription[]
  walletCardAliases  WalletCardAlias[]
  createdAt          DateTime            @default(now())

  /// Quanto da renda o usuário aceita ver comprometido com despesa fixa e fatura
  /// de cartão, em porcentagem inteira. É o teto que a pergunta "posso comprar
  /// isso?" usa para reprovar uma compra que cabe no saldo mas aperta o mês.
  /// Nulo = nunca configurado, e vale DEFAULT_COMMITMENT_LIMIT_PERCENT de
  /// src/lib/purchase-simulation.ts — um @default aqui apagaria a diferença
  /// entre "não escolheu" e "escolheu 70", e a tela não teria como dizer qual.
  commitmentLimitPercent Int?
  /// Quando terminou o passo a passo do primeiro uso (/comecar). Nulo = ainda
  /// não terminou, e entrar no app leva para lá. Depois de preenchido, nunca
  /// mais força: apagar a renda depois não manda a pessoa de volta.
  onboardedAt            DateTime?
  /// SHA-256 da chave do atalho do iPhone (src/app/api/atalho). A chave em si
  /// só aparece uma vez, quando é gerada; trocar a chave invalida a anterior.
  shortcutTokenHash      String?   @unique
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  cardPurchases CardPurchase[]
  fixedExpenses FixedExpense[]

  @@index([userId])
}

model Income {
  id         String          @id @default(cuid())
  userId     String
  label      String
  amount     Decimal
  dayOfMonth Int
  active     Boolean         @default(true)
  /// Apagada pelo usuário: some das listas, mas a linha continua no banco para
  /// os recebimentos dela seguirem contando no Histórico, no saldo em conta e
  /// nos períodos passados. Apagar de verdade levaria os recebimentos junto por
  /// cascade e reescreveria o dinheiro que de fato entrou.
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts   IncomeReceipt[]

  @@index([userId])
}

/// Confirmation that a specific monthly occurrence of a fixed income was
/// actually received. Unconfirmed occurrences don't count toward the
/// period budget — see calculateDailyBudget in src/lib/period.ts.
model IncomeReceipt {
  id             String   @id @default(cuid())
  incomeId       String
  userId         String
  occurrenceDate DateTime
  amount         Decimal
  createdAt      DateTime @default(now())
  income         Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incomeId, occurrenceDate])
  @@index([userId])
}

model FixedExpense {
  id               String              @id @default(cuid())
  userId           String
  label            String
  amount           Decimal
  dueDay           Int?
  /// Quantas cobranças faltam, contadas a partir do primeiro vencimento depois
  /// do cadastro. Nulo = não termina (aluguel, assinatura). É o que dá sentido
  /// a adiar uma parcela "para depois da última". Só para despesa avulsa: no
  /// cartão, o parcelamento é da compra.
  installmentCount Int?
  active           Boolean             @default(true)
  /// Quando a despesa deixou de ser cobrada — ao ser pausada ou apagada. É por
  /// esta data que se sabe onde cortar: os ciclos que fecharam antes dela
  /// continuam cobrando a despesa, e é isso que impede um encerramento de
  /// apagar retroativamente dinheiro que de fato saiu. Nulo = ainda vigente.
  /// Ver isExpenseOccurrenceValid em src/lib/period.ts.
  endedAt          DateTime?
  /// Apagada pelo usuário: some das listas de Fixos, mas a linha continua no
  /// banco para o Histórico dos meses em que ela foi cobrada seguir de pé.
  /// Sem volta pela interface, ao contrário de `active`.
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  cardId           String?
  categoryId       String?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             CreditCard?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments         ExpensePayment[]
  pauses           FixedExpensePause[]
  deferrals        ExpenseDeferral[]

  @@index([userId])
  @@index([cardId])
  @@index([categoryId])
}

/// Um intervalo em que a despesa fixa ficou pausada. As ocorrências dentro dele
/// não são cobradas; as de antes e as de depois, sim.
///
/// Antes a pausa era gravada em `FixedExpense.endedAt`, e reativar apagava a
/// data — e com ela o corte: os meses pausados voltavam a ser cobrados, e o
/// saldo de hoje caía por um dinheiro que nunca saiu. Uma linha por pausa
/// guarda cada intervalo. `endedAt` nulo = ainda pausada.
/// Ver isExpenseOccurrenceValid em src/lib/period.ts.
model FixedExpensePause {
  id             String       @id @default(cuid())
  fixedExpenseId String
  userId         String
  startedAt      DateTime
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fixedExpenseId])
  @@index([userId])
}

/// Uma ocorrência de despesa fixa que foi adiada em vez de paga.
///
/// A ocorrência de `dueDate` deixa de ser cobrada, e `amount` — o valor
/// adiado, que pode ter juros ou multa — passa a pesar em `targetDueDate`:
/// somado à ocorrência do mês seguinte ("nextMonth"), ou como uma cobrança
/// extra depois da última parcela ("end"). O alvo é calculado e gravado na
/// hora de adiar, para não mudar de lugar se a despesa for editada depois.
/// Ver expenseCharges em src/lib/period.ts.
model ExpenseDeferral {
  id             String       @id @default(cuid())
  userId         String
  fixedExpenseId String
  /// A ocorrência adiada. Mesma convenção de ExpensePayment.dueDate.
  dueDate        DateTime
  targetDueDate  DateTime
  amount         Decimal
  /// "nextMonth" | "end"
  mode           String
  createdAt      DateTime     @default(now())
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fixedExpenseId, dueDate])
  @@index([userId])
}

/// Confirmação de que uma ocorrência específica de despesa (fatura de cartão
/// ou despesa fixa) foi paga. Uma ocorrência paga sai dos lembretes mas
/// continua somando no total do período — ver calculateDailyBudget em
/// src/lib/period.ts.
model ExpensePayment {
  id             String        @id @default(cuid())
  userId         String
  /// Preenchido quando o pagamento quita uma despesa fixa avulsa.
  fixedExpenseId String?
  /// Preenchido quando o pagamento quita a fatura de um cartão.
  cardId         String?
  /// O vencimento da ocorrência quitada — a identidade do pagamento, mesmo
  /// quando ele acontece antes do vencimento.
  dueDate        DateTime
  amount         Decimal
  /// Quando o pagamento foi confirmado. É por esta data que o Histórico
  /// agrupa o pagamento em um mês.
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  /// Preenchido quando a despesa fixa daquele mês foi paga no cartão. O
  /// dinheiro passa a morar na compra, que entra na fatura; este pagamento
  /// fica com amount 0 e só existe para quitar a ocorrência. Apagar a compra
  /// apaga o pagamento junto, e o lembrete volta.
  cardPurchaseId String?       @unique
  /// false = pagamento parcial de uma despesa fixa ou fatura: abate do valor, mas a
  /// ocorrência segue em aberto, e o lembrete continua com o que falta. Uma
  /// ocorrência pode ter vários parciais e, no fim, um que a quita.
  settled        Boolean       @default(true)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  card           CreditCard?   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardPurchase   CardPurchase? @relation(fields: [cardPurchaseId], references: [id], onDelete: Cascade)

  /// Sem UNIQUE: os pagamentos parciais de uma despesa fixa ou de uma fatura
  /// dividem o vencimento.
  @@index([fixedExpenseId, dueDate])
  @@index([cardId, dueDate])
  @@index([userId, paidAt])
}

model Transaction {
  id              String         @id @default(cuid())
  userId          String
  amount          Decimal
  description     String
  date            DateTime       @default(now())
  /// Quando o lançamento foi cadastrado — é daqui que sai a hora exibida.
  /// `date` é um dia do calendário (meia-noite UTC) e não carrega horário.
  /// Nulo nos lançamentos anteriores a esta coluna, que então só mostram o dia.
  createdAt       DateTime?      @default(now())
  /// Linha que o fechamento de período antigo criava para devolver a sobra ao
  /// orçamento seguinte. Não é criada mais: o saldo passa de um período ao
  /// outro sozinho (src/lib/carry-over.ts). As que existem ficam de fora de
  /// tudo — orçamento, previsão, saldo em conta e Histórico —, porque contá-las
  /// levaria a mesma sobra duas vezes.
  fromPeriodClose Boolean        @default(false)
  categoryId      String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Esta despesa foi emprestada para alguém (ver Loan).
  loan            Loan?
  /// Esta receita é dinheiro que alguém devolveu (ver LoanRepayment).
  loanRepayment   LoanRepayment?
  /// O nome do cartão que a Carteira mandou pelo atalho, quando o app não o
  /// reconheceu e lançou como gasto da conta. Ligar esse nome a um cartão
  /// (WalletCardAlias) move estes lançamentos para o cartão.
  walletCardName  String?

  @@index([userId, date])
  @@index([categoryId])
}

model CreditCard {
  id            String             @id @default(cuid())
  userId        String
  name          String
  closingDay    Int
  dueDay        Int
  active        Boolean            @default(true)
  /// Limite total do cartão. Opcional: sem ele a tela não mostra o bloco de
  /// usado/disponível, em vez de fingir um limite que o usuário não informou.
  /// O nome não é `limit` porque essa é palavra reservada em SQL e precisaria de
  /// aspas em toda migration escrita à mão.
  creditLimit   Decimal?
  /// A cor do cartão, do catálogo de src/lib/card-look.ts ("nubank:roxinho").
  /// Vazio = a cor automática.
  style         String?
  /// Apagado pelo usuário: some das listas, mas continua no banco com as compras,
  /// os pagamentos e as previsões. Apagar de verdade levava tudo por cascade — o
  /// Histórico perdia os gastos e o saldo em conta subia pelos pagamentos que
  /// sumiam. As parcelas que ainda faltam continuam devidas.
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases     CardPurchase[]
  walletAliases WalletCardAlias[]
  fixedExpenses FixedExpense[]
  payments      ExpensePayment[]
  billEstimates CardBillEstimate[]

  @@index([userId])
}

model CardPurchase {
  id             String          @id @default(cuid())
  cardId         String
  userId         String
  amount         Decimal
  description    String
  date           DateTime        @default(now())
  /// Mesma coisa que em Transaction: o dia vem de `date`, a hora daqui.
  createdAt      DateTime?       @default(now())
  /// Em quantas parcelas a compra foi dividida. 1 = à vista no cartão.
  /// `amount` continua sendo o TOTAL da compra — a parcela é derivada em
  /// src/lib/period.ts, não gravada.
  installments   Int             @default(1)
  categoryId     String?
  card           CreditCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expensePayment ExpensePayment?
  /// Esta compra foi feita para alguém, que vai devolver (ver Loan).
  loan           Loan?

  @@index([cardId, date])
  @@index([userId])
  @@index([categoryId])
}

/// Um valor previsto que o usuário lança à mão na fatura de um vencimento
/// futuro — a anuidade, o IOF de uma compra em dólar, a parcela de algo
/// comprado fora do app. Soma-se ao que as compras calculam; não substitui.
///
/// Sem @@unique([cardId, dueDate]), ao contrário de ExpensePayment: lá existe
/// exatamente um ato de pagar a fatura de janeiro, aqui a anuidade e o IOF
/// podem cair na mesma fatura, e juntá-los numa linha só apagaria a descrição
/// de cada um. É por isso também que a descrição é obrigatória.
model CardBillEstimate {
  id          String     @id @default(cuid())
  userId      String
  cardId      String
  /// O vencimento da fatura em que este valor entra. Mesma convenção de
  /// ExpensePayment.dueDate: um dia de calendário, sem horário.
  dueDate     DateTime
  amount      Decimal
  description String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, dueDate])
  @@index([userId])
}

model Jar {
  id        String       @id @default(cuid())
  userId    String
  name      String
  color     String?
  balance   Decimal      @default(0)
  /// Apagada pelo usuário: some da lista, mas os depósitos continuam — foi
  /// dinheiro que saiu do disponível. Só dá para apagar uma caixinha vazia; o
  /// saldo dela sai antes por um resgate.
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits  JarDeposit[]

  @@index([userId])
}

model JarDeposit {
  id              String   @id @default(cuid())
  jarId           String
  userId          String
  amount          Decimal
  note            String?
  createdAt       DateTime @default(now())
  /// Depósito que o fechamento de período antigo criava. Os de agora são
  /// depósitos comuns (fromPeriodClose false): guardar a sobra numa caixinha
  /// tira o dinheiro do disponível, como qualquer depósito. Os antigos seguem
  /// fora do saldo em conta, que foi informado contando com eles assim.
  fromPeriodClose Boolean  @default(false)
  /// Quanto o saldo da caixinha mudou com este movimento, quando difere de
  /// `amount`: um resgate maior que o saldo (o rendimento do CDB) zera a
  /// caixinha, mas o valor inteiro volta para o disponível. O "Desfazer" usa
  /// isto para devolver o saldo de antes. Nulo = igual a `amount`.
  balanceChange   Decimal?
  jar             Jar      @relation(fields: [jarId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jarId])
  @@index([userId])
}

/// O fechamento de cada período (de um pagamento ao seguinte). Não é mais ele
/// que leva a sobra adiante — isso é automático, ver src/lib/carry-over.ts —:
/// serve para perguntar uma vez só se a sobra vai para uma caixinha.
/// resolvedAt nulo = a pergunta ainda não foi respondida.
model PeriodAllocation {
  id             String    @id @default(cuid())
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  leftoverAmount Decimal
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodEnd])
  @@index([userId])
}

/// Uma leitura do extrato: "neste instante o banco dizia X". O saldo em conta
/// exibido na home é derivado do ajuste mais recente somado a tudo que foi
/// registrado depois dele — ver src/lib/account-balance.ts.
///
/// Cada correção cria uma linha nova; nada é sobrescrito. `createdAt` não é só
/// carimbo de auditoria: é o marco a partir do qual a soma começa.
model BalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  balance   Decimal
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Alguém a quem você emprestou dinheiro. Criada na hora, pelo nome digitado
/// no formulário — não há tela de cadastro.
model Person {
  id         String          @id @default(cuid())
  userId     String
  name       String
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans      Loan[]
  repayments LoanRepayment[]

  @@unique([userId, name])
}

/// Uma despesa (lançamento ou compra no cartão) feita por alguém, que vai
/// devolver. O dinheiro já saiu — a despesa conta no orçamento normalmente —;
/// o empréstimo só lembra quem deve e quanto. Apagar a despesa apaga o
/// empréstimo junto.
model Loan {
  id             String        @id @default(cuid())
  userId         String
  personId       String
  /// Quanto a pessoa deve. Pode ser menos que a despesa (uma conta dividida).
  amount         Decimal
  /// Em quantas vezes a pessoa combinou devolver. 1 = de uma vez.
  installments   Int           @default(1)
  /// Quando vence a primeira parcela (as outras, mês a mês). Nulo = sem data.
  firstDueDate   DateTime?
  transactionId  String?       @unique
  cardPurchaseId String?       @unique
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  person         Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  cardPurchase   CardPurchase? @relation(fields: [cardPurchaseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([personId])
}

/// Dinheiro que uma pessoa devolveu. É uma receita comum (a Transaction
/// ligada, com valor negativo), então entra no saldo, no orçamento e no
/// Histórico sem regra nova; esta linha só diz de quem veio. Abate os
/// empréstimos mais antigos primeiro (src/lib/loans.ts). Apagar a receita
/// desfaz o recebimento.
model LoanRepayment {
  id            String      @id @default(cuid())
  userId        String
  personId      String
  transactionId String      @unique
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([personId])
}

/// Um aparelho que aceitou receber avisos (Web Push). O mesmo usuário pode ter
/// vários; o endereço é único porque o navegador o gera por aparelho.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// O nome de um cartão como a Carteira do iPhone manda pelo atalho, ligado ao
/// cartão do app que a pessoa escolheu. `cardId` nulo e `asAccount` falso =
/// ainda sem resposta, e a tela Cartões pergunta. `asAccount` = é débito: as
/// compras com esse nome ficam como gasto da conta, sem perguntar de novo.
model WalletCardAlias {
  id         String      @id @default(cuid())
  userId     String
  /// Como chegou, para mostrar ("Sicoob Visa").
  walletName String
  /// Normalizado (src/lib/shortcut.ts), para comparar.
  normalized String
  cardId     String?
  asAccount  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([userId, normalized])
}
