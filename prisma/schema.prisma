// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  incomes           Income[]
  incomeReceipts    IncomeReceipt[]
  fixedExpenses     FixedExpense[]
  transactions      Transaction[]
  creditCards       CreditCard[]
  cardPurchases     CardPurchase[]
  jars              Jar[]
  jarDeposits       JarDeposit[]
  periodAllocations PeriodAllocation[]
  categories        Category[]
  expensePayments   ExpensePayment[]
  cardBillEstimates CardBillEstimate[]
  createdAt         DateTime           @default(now())
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  cardPurchases CardPurchase[]
  fixedExpenses FixedExpense[]

  @@index([userId])
}

model Income {
  id         String          @id @default(cuid())
  userId     String
  label      String
  amount     Decimal
  dayOfMonth Int
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts   IncomeReceipt[]

  @@index([userId])
}

/// Confirmation that a specific monthly occurrence of a fixed income was
/// actually received. Unconfirmed occurrences don't count toward the
/// period budget — see calculateDailyBudget in src/lib/period.ts.
model IncomeReceipt {
  id             String   @id @default(cuid())
  incomeId       String
  userId         String
  occurrenceDate DateTime
  amount         Decimal
  createdAt      DateTime @default(now())
  income         Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incomeId, occurrenceDate])
  @@index([userId])
}

model FixedExpense {
  id         String           @id @default(cuid())
  userId     String
  label      String
  amount     Decimal
  dueDay     Int?
  active     Boolean          @default(true)
  /// Quando a despesa deixou de ser cobrada — ao ser pausada ou apagada. É por
  /// esta data que se sabe onde cortar: os ciclos que fecharam antes dela
  /// continuam cobrando a despesa, e é isso que impede um encerramento de
  /// apagar retroativamente dinheiro que de fato saiu. Nulo = ainda vigente.
  /// Ver isExpenseOccurrenceValid em src/lib/period.ts.
  endedAt    DateTime?
  /// Apagada pelo usuário: some das listas de Fixos, mas a linha continua no
  /// banco para o Histórico dos meses em que ela foi cobrada seguir de pé.
  /// Sem volta pela interface, ao contrário de `active`.
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  cardId     String?
  categoryId String?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       CreditCard?      @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments   ExpensePayment[]

  @@index([userId])
  @@index([cardId])
  @@index([categoryId])
}

/// Confirmação de que uma ocorrência específica de despesa (fatura de cartão
/// ou despesa fixa) foi paga. Uma ocorrência paga sai dos lembretes mas
/// continua somando no total do período — ver calculateDailyBudget em
/// src/lib/period.ts.
model ExpensePayment {
  id             String        @id @default(cuid())
  userId         String
  /// Preenchido quando o pagamento quita uma despesa fixa avulsa.
  fixedExpenseId String?
  /// Preenchido quando o pagamento quita a fatura de um cartão.
  cardId         String?
  /// O vencimento da ocorrência quitada — a identidade do pagamento, mesmo
  /// quando ele acontece antes do vencimento.
  dueDate        DateTime
  amount         Decimal
  /// Quando o pagamento foi confirmado. É por esta data que o Histórico
  /// agrupa o pagamento em um mês.
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  card           CreditCard?   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([fixedExpenseId, dueDate])
  @@unique([cardId, dueDate])
  @@index([userId, paidAt])
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Decimal
  description String
  date        DateTime  @default(now())
  /// Quando o lançamento foi cadastrado — é daqui que sai a hora exibida.
  /// `date` é um dia do calendário (meia-noite UTC) e não carrega horário.
  /// Nulo nos lançamentos anteriores a esta coluna, que então só mostram o dia.
  createdAt   DateTime? @default(now())
  categoryId  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
}

model CreditCard {
  id            String             @id @default(cuid())
  userId        String
  name          String
  closingDay    Int
  dueDay        Int
  active        Boolean            @default(true)
  /// Limite total do cartão. Opcional: sem ele a tela não mostra o bloco de
  /// usado/disponível, em vez de fingir um limite que o usuário não informou.
  /// O nome não é `limit` porque essa é palavra reservada em SQL e precisaria de
  /// aspas em toda migration escrita à mão.
  creditLimit   Decimal?
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases     CardPurchase[]
  fixedExpenses FixedExpense[]
  payments      ExpensePayment[]
  billEstimates CardBillEstimate[]

  @@index([userId])
}

model CardPurchase {
  id           String     @id @default(cuid())
  cardId       String
  userId       String
  amount       Decimal
  description  String
  date         DateTime   @default(now())
  /// Mesma coisa que em Transaction: o dia vem de `date`, a hora daqui.
  createdAt    DateTime?  @default(now())
  /// Em quantas parcelas a compra foi dividida. 1 = à vista no cartão.
  /// `amount` continua sendo o TOTAL da compra — a parcela é derivada em
  /// src/lib/period.ts, não gravada.
  installments Int        @default(1)
  categoryId   String?
  card         CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([cardId, date])
  @@index([userId])
  @@index([categoryId])
}

/// Um valor previsto que o usuário lança à mão na fatura de um vencimento
/// futuro — a anuidade, o IOF de uma compra em dólar, a parcela de algo
/// comprado fora do app. Soma-se ao que as compras calculam; não substitui.
///
/// Sem @@unique([cardId, dueDate]), ao contrário de ExpensePayment: lá existe
/// exatamente um ato de pagar a fatura de janeiro, aqui a anuidade e o IOF
/// podem cair na mesma fatura, e juntá-los numa linha só apagaria a descrição
/// de cada um. É por isso também que a descrição é obrigatória.
model CardBillEstimate {
  id          String     @id @default(cuid())
  userId      String
  cardId      String
  /// O vencimento da fatura em que este valor entra. Mesma convenção de
  /// ExpensePayment.dueDate: um dia de calendário, sem horário.
  dueDate     DateTime
  amount      Decimal
  description String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, dueDate])
  @@index([userId])
}

model Jar {
  id        String       @id @default(cuid())
  userId    String
  name      String
  color     String?
  balance   Decimal      @default(0)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits  JarDeposit[]

  @@index([userId])
}

model JarDeposit {
  id        String   @id @default(cuid())
  jarId     String
  userId    String
  amount    Decimal
  note      String?
  createdAt DateTime @default(now())
  jar       Jar      @relation(fields: [jarId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jarId])
  @@index([userId])
}

/// Records the close of each period (between one payday and the next).
/// resolvedAt null means the leftover is still pending a jar allocation decision.
model PeriodAllocation {
  id             String    @id @default(cuid())
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  leftoverAmount Decimal
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodEnd])
  @@index([userId])
}
