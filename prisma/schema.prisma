// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  incomes           Income[]
  incomeReceipts    IncomeReceipt[]
  fixedExpenses     FixedExpense[]
  transactions      Transaction[]
  creditCards       CreditCard[]
  cardPurchases     CardPurchase[]
  jars              Jar[]
  jarDeposits       JarDeposit[]
  periodAllocations PeriodAllocation[]
  categories        Category[]
  createdAt         DateTime           @default(now())
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  cardPurchases CardPurchase[]

  @@index([userId])
}

model Income {
  id         String          @id @default(cuid())
  userId     String
  label      String
  amount     Decimal
  dayOfMonth Int
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts   IncomeReceipt[]

  @@index([userId])
}

/// Confirmation that a specific monthly occurrence of a fixed income was
/// actually received. Unconfirmed occurrences don't count toward the
/// period budget — see calculateDailyBudget in src/lib/period.ts.
model IncomeReceipt {
  id             String   @id @default(cuid())
  incomeId       String
  userId         String
  occurrenceDate DateTime
  amount         Decimal
  createdAt      DateTime @default(now())
  income         Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incomeId, occurrenceDate])
  @@index([userId])
}

model FixedExpense {
  id        String      @id @default(cuid())
  userId    String
  label     String
  amount    Decimal
  dueDay    Int?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  cardId    String?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cardId])
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Decimal
  description String
  date        DateTime  @default(now())
  categoryId  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
}

model CreditCard {
  id         String         @id @default(cuid())
  userId     String
  name       String
  closingDay Int
  dueDay     Int
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases  CardPurchase[]
  fixedExpenses FixedExpense[]

  @@index([userId])
}

model CardPurchase {
  id          String     @id @default(cuid())
  cardId      String
  userId      String
  amount      Decimal
  description String
  date        DateTime   @default(now())
  categoryId  String?
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([cardId, date])
  @@index([userId])
  @@index([categoryId])
}

model Jar {
  id        String       @id @default(cuid())
  userId    String
  name      String
  color     String?
  balance   Decimal      @default(0)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits  JarDeposit[]

  @@index([userId])
}

model JarDeposit {
  id        String   @id @default(cuid())
  jarId     String
  userId    String
  amount    Decimal
  note      String?
  createdAt DateTime @default(now())
  jar       Jar      @relation(fields: [jarId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jarId])
  @@index([userId])
}

/// Records the close of each period (between one payday and the next).
/// resolvedAt null means the leftover is still pending a jar allocation decision.
model PeriodAllocation {
  id             String    @id @default(cuid())
  userId         String
  periodStart    DateTime
  periodEnd      DateTime
  leftoverAmount Decimal
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodEnd])
  @@index([userId])
}
